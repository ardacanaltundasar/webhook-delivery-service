ENVIRONMENT=development
LOG_LEVEL=INFO

# Shared key for internal services calling the ingestion API (X-API-Key header)
API_KEY=change-me-to-a-long-random-string

DATABASE_URL=postgresql+asyncpg://webhooks:webhooks@localhost:5432/webhooks
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TTL_SECONDS=30

DELIVERY_MAX_ATTEMPTS=5
DELIVERY_TIMEOUT_SECONDS=10
RETRY_BACKOFF_BASE_SECONDS=2
RETRY_BACKOFF_MAX_SECONDS=600
RESPONSE_SNIPPET_MAX_LENGTH=1024
SIGNATURE_TOLERANCE_SECONDS=300
